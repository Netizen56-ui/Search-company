name: Pipeline Automático

on:
  schedule:
    # Se ejecuta cada hora (puedes cambiarlo usando formato cron)
    - cron: '0 * * * *'
  workflow_dispatch: # Permite ejecutarlo manualmente desde la web de GitHub

permissions:
  contents: write # Permiso obligatorio para que el bot pueda guardar los datos

jobs:
  ejecutar-pipeline:
    runs-on: ubuntu-latest
    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      # Descomenta esto si tu script de Python necesita instalar librerías externas (como requests, pandas, etc.)
      # - name: Instalar dependencias
      #   run: pip install -r requirements.txt

      - name: Ejecutar script
        run: python pipeline.py

      - name: Guardar cambios en GitHub (Commit automático)
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'
          git add data.json
          git commit -m "Automated update via GitHub Actions" || exit 0
          git push
